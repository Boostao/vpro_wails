        If Not MyRS.NoMatch Then
            SqlText = "INSERT INTO " & clsVProReg.CurrProject & "_Metadata ( ProjectID, ProjectTitle, CoordinatingAgency, ProponentFunder, FieldCompanyAgency, FieldLeader, FieldDataCollectionTeam, ProjectPurpose, GeographicStudyArea, GeographicStudyRegion, StartDate, EndDate, NumberOfFS882Plots, NumberOfSiteVisits, CollectedSite, CollectedVeg, CollectedSoil, CollectedTerrain, CollectedMens, CollectedCWD, CollectedWildTree, CollectedSoilChem, GeoRefMethod, Datum, CoordinateSystem, EcosysCollectionStandard, VegCoverMethod, MensurationMethod, ExtraVegFieldDescription, PlotMethod, DataCustodian, StorageLocation, Notes )"
            SqlText = SqlText & " SELECT ProjectID, ProjectTitle, CoordinatingAgency, ProponentFunder, FieldCompanyAgency, FieldLeader, FieldDataCollectionTeam, ProjectPurpose, GeographicStudyArea, GeographicStudyRegion, StartDate, EndDate, NumberOfFS882Plots, NumberOfSiteVisits, CollectedSite, CollectedVeg, CollectedSoil, CollectedTerrain, CollectedMens, CollectedCWD, CollectedWildTree, CollectedSoilChem, GeoRefMethod, Datum, CoordinateSystem, EcosysCollectionStandard, VegCoverMethod, MensurationMethod, ExtraVegFieldDescription, PlotMethod, DataCustodian, StorageLocation, Notes"
            SqlText = SqlText & " FROM ProjectMetaData"
            SqlText = SqlText & " WHERE (((ProjectMetaData.ProjectID)='" & Me.ProjectID.Value & "'));"
