# Wails Server Mode Dockerfile
# Multi-stage build for a minimal CGO-enabled SQLite canonical image.
#
# Defaults build VPro with CGO_ENABLED=1 and -tags server,production,sqliteonly
# on Debian 13 (trixie) so Wails v3 Linux CGO pkg-config headers (gtk4 / webkitgtk-6.0)
# and runtime shared libraries resolve cleanly, with writable VPRO_DATA_DIR and VPRO_CONFIG_DIR.

ARG GO_IMAGE=golang:1.26-trixie
ARG RUNTIME_IMAGE=debian:trixie-slim
ARG CGO_ENABLED=1
ARG EXTRA_TAGS=sqliteonly

# Build stage
FROM ${GO_IMAGE} AS builder
ARG CGO_ENABLED
ARG EXTRA_TAGS

WORKDIR /app

# Install build dependencies: git + C toolchain + Wails Linux GTK4/WebKitGTK 6.0 headers when CGO is enabled.
RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git pkgconf $([ "$CGO_ENABLED" = "1" ] && echo gcc musl-dev gtk4.0-dev webkit2gtk-4.1-dev); \
    else \
        apt-get update && apt-get install -y --no-install-recommends git $([ "$CGO_ENABLED" = "1" ] && echo pkg-config gcc libc6-dev libgtk-4-dev libwebkitgtk-6.0-dev) && rm -rf /var/lib/apt/lists/*; \
    fi

# Copy source code
COPY . .

# Remove local replace directive if present (for production builds)
RUN sed -i '/^replace/d' go.mod || true

# Download dependencies
RUN go mod tidy

# Build the production server binary with canonical SQLite tags and CGO enabled.
RUN CGO_ENABLED=${CGO_ENABLED} go build -tags "server,production${EXTRA_TAGS:+,${EXTRA_TAGS}}" -trimpath -buildvcs=false -ldflags="-s -w" -o server . && \
    mkdir -p /out/var/lib/vpro/data /out/var/lib/vpro/config && \
    chmod 0777 /out/var/lib/vpro /out/var/lib/vpro/data /out/var/lib/vpro/config

# Runtime stage - minimal glibc-compatible image with required shared libraries
FROM ${RUNTIME_IMAGE}

RUN if command -v apt-get >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends ca-certificates libgtk-4-1 libwebkitgtk-6.0-4 && rm -rf /var/lib/apt/lists/*; \
    fi

# Copy the binary and pre-created writable runtime directories
COPY --from=builder /app/server /server
COPY --from=builder /app/frontend/dist /frontend/dist
COPY --from=builder /out/var/lib/vpro /var/lib/vpro

# Expose the default port
EXPOSE 8080

# Bind to all interfaces (required for Docker) and configure writable storage roots
ENV WAILS_SERVER_HOST=0.0.0.0
ENV VPRO_DATA_DIR=/var/lib/vpro/data
ENV VPRO_CONFIG_DIR=/var/lib/vpro/config

# Run the server
ENTRYPOINT ["/server"]
